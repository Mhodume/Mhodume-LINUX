<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mhodume.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <!-- Palette — carried over verbatim from the Windows app so the
                 Linux build looks the same. -->
            <Color x:Key="BgColor">#FF0B0C0F</Color>
            <Color x:Key="PanelColor">#FF14161B</Color>
            <Color x:Key="PanelAltColor">#FF1C1F26</Color>
            <Color x:Key="AccentColor">#FFFF4A1E</Color>
            <Color x:Key="TextColor">#FFE8EBF0</Color>
            <Color x:Key="MutedColor">#FF7C8494</Color>

            <SolidColorBrush x:Key="Bg"        Color="{StaticResource BgColor}" />
            <SolidColorBrush x:Key="Panel"     Color="{StaticResource PanelColor}" />
            <SolidColorBrush x:Key="PanelAlt"  Color="{StaticResource PanelAltColor}" />
            <SolidColorBrush x:Key="Accent"    Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="Text"      Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="Muted"     Color="{StaticResource MutedColor}" />
            <SolidColorBrush x:Key="Line"      Color="#FF262B34" />
            <SolidColorBrush x:Key="Edge"      Color="#FF3D4450" />
            <SolidColorBrush x:Key="Selected"  Color="#22FF4A1E" />
            <SolidColorBrush x:Key="AccentDim" Color="#99FF4A1E" />

            <FontFamily x:Key="Mono">Cascadia Code, Consolas, DejaVu Sans Mono, monospace</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- A flat, dark button that matches the app's slabs. -->
        <Style Selector="Button.mode">
            <Setter Property="Background" Value="{StaticResource PanelAlt}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <Style Selector="Button.mode:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Selected}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>

        <!-- Section label: small, muted, spaced caps. -->
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LetterSpacing" Value="1" />
        </Style>
    </Application.Styles>
</Application>
