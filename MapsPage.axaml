<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Mhodume"
             x:Class="Mhodume.MapsPage"
             x:CompileBindings="False">

    <UserControl.Resources>
        <!-- One row of the table. The three column widths are repeated in the
             header above the list; if one moves, both move. -->
        <DataTemplate x:Key="MapRow">
            <Grid Height="26" ColumnDefinitions="*,92,52">
                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontFamily="Segoe UI"
                           FontSize="12.5" Margin="0,0,12,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding AssetNote}"/>

                <TextBlock Grid.Column="1" Text="{Binding BestText}"
                           FontFamily="{StaticResource Mono}" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="{Binding RunCountText}"
                           FontFamily="{StaticResource Mono}" FontSize="12"
                           Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- one recorded run of the selected map -->
        <DataTemplate x:Key="RunRow">
            <Grid Margin="2,4" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="{Binding PlayerName}" FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Category}" FontSize="10"
                               Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding TimeText}"
                           FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ColumnDefinitions="*,340">

        <!-- ============================ MAP LIST ============================ -->
        <Grid Grid.Column="0" Margin="24,16,16,20" RowDefinitions="Auto,Auto,Auto,*">

            <TextBlock Grid.Row="0" x:Name="ListSummary" Text=""
                       HorizontalAlignment="Right"
                       FontFamily="{StaticResource Mono}" FontSize="11"
                       Foreground="{StaticResource Muted}"/>

            <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,12"
                       Foreground="{StaticResource Muted}" FontSize="12" LineHeight="18"
                       Text="Every map the game has recorded a time or a run for. Times come from your save file, runs from your ghost folder. Pick a map to see its runs and draw one as a route."/>

            <Grid Grid.Row="2" Margin="0,0,0,10" ColumnDefinitions="*,Auto,Auto">
                <Grid Grid.Column="0">
                    <TextBox x:Name="FilterBox" TextChanged="Filter_Changed"
                             ToolTip.Tip="Type part of a map name to narrow the list — the game's name or the file name"/>
                    <TextBlock x:Name="FilterHint" Text="Filter maps…" IsHitTestVisible="False"
                               Foreground="{StaticResource Muted}" FontSize="12"
                               FontFamily="{StaticResource Mono}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
                <CheckBox Grid.Column="1" x:Name="OnlyWithRuns" Margin="10,0,0,0"
                          VerticalAlignment="Center" Content="With runs only"
                          IsCheckedChanged="Filter_Changed"/>
                <Button Grid.Column="2" Content="Rescan" Margin="10,0,0,0" Click="Rescan_Click"/>
            </Grid>

            <Border Grid.Row="3" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">

                    <!-- Column header. Same three widths as MapRow, plus the
                         seven pixels of padding a row carries. -->
                    <Border Grid.Row="0" Padding="15,7,18,6"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,92,52">
                            <TextBlock Grid.Column="0" Text="MAP"
                                       FontFamily="{StaticResource Mono}" FontSize="10"
                                       Foreground="{StaticResource Muted}"/>
                            <TextBlock Grid.Column="1" Text="BEST"
                                       FontFamily="{StaticResource Mono}" FontSize="10"
                                       Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="RUNS"
                                       FontFamily="{StaticResource Mono}" FontSize="10"
                                       Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="MapList" ItemTemplate="{StaticResource MapRow}"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 Margin="0,4,0,4"
                                 SelectionChanged="MapList_SelectionChanged">
                            <!-- Table rows are tighter than the navigation rows the
                                 default style is cut for: forty-six of them have to be
                                 scannable at once. -->
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="7,0"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </ListBox.Styles>
                        </ListBox>

                        <!-- Reading the save: the shape of what is coming,
                             rather than a black panel with a sentence in it. -->
                        <StackPanel x:Name="ScanSkeleton" Margin="15,12,15,0"
                                    IsVisible="False">
                            <Rectangle Height="9" Fill="{StaticResource PanelAlt}"
                                       HorizontalAlignment="Left" Margin="0,0,0,17" Width="210"/>
                            <Rectangle Height="9" Fill="{StaticResource PanelAlt}"
                                       HorizontalAlignment="Left" Margin="0,0,0,17" Width="164"/>
                            <Rectangle Height="9" Fill="{StaticResource PanelAlt}"
                                       HorizontalAlignment="Left" Margin="0,0,0,17" Width="232"/>
                            <Rectangle Height="9" Fill="{StaticResource PanelAlt}"
                                       HorizontalAlignment="Left" Margin="0,0,0,17" Width="188"/>
                            <Rectangle Height="9" Fill="{StaticResource PanelAlt}"
                                       HorizontalAlignment="Left" Margin="0,0,0,17" Width="146"/>
                            <Rectangle Height="9" Fill="{StaticResource PanelAlt}"
                                       HorizontalAlignment="Left" Margin="0,0,0,17" Width="204"/>
                            <TextBlock Text="reading save and ghosts…" Margin="0,4,0,0"
                                       FontFamily="{StaticResource Mono}" FontSize="11"
                                       Foreground="{StaticResource Muted}"/>
                        </StackPanel>

                        <!-- Nothing to show: what happened, why, and what to
                             do about it. -->
                        <StackPanel x:Name="EmptyState" IsVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="24">
                            <TextBlock x:Name="EmptyTitle" Text="No times recorded yet"
                                       FontFamily="{StaticResource Mono}" FontSize="13"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyWhy" TextWrapping="Wrap" MaxWidth="330"
                                       Margin="0,8,0,0" TextAlignment="Center" LineHeight="18"
                                       Foreground="{StaticResource Muted}" FontSize="12"
                                       Text="Finish any level once — times are read from your save file."/>
                            <Button x:Name="EmptyAction" Content="Rescan" Margin="0,14,0,0"
                                    HorizontalAlignment="Center" Click="Rescan_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- =========================== MAP DETAIL =========================== -->
        <Border Grid.Column="1" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16,18,20">
                <StackPanel>

                    <TextBlock x:Name="DetailMap" Text="No map selected"
                               FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DetailAsset" Text="" TextWrapping="Wrap"
                               FontFamily="{StaticResource Mono}" FontSize="11"
                               Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="DetailBest" Text="Pick a map on the left."
                               Foreground="{StaticResource Muted}" FontSize="12"
                               Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="18"/>

                    <!-- per-variant times, when the save keeps more than one -->
                    <ItemsControl x:Name="VariantList" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11"
                                               Foreground="{StaticResource Muted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="11"
                                               FontFamily="Consolas"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <local:SectionHeader Text="SAVED RUNS"/>

                    <Border Background="{StaticResource PanelAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="6"
                            MinHeight="90">
                        <Grid>
                            <ListBox x:Name="RunList" ItemTemplate="{StaticResource RunRow}"
                                     Background="Transparent" BorderThickness="0"
                                    
                                     MaxHeight="240"
                                     SelectionChanged="RunList_SelectionChanged"/>
                            <TextBlock x:Name="NoRuns" Text="No run saved for this map"
                                       Foreground="{StaticResource Muted}" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Button x:Name="DrawButton" Content="Draw this run as a route"
                            Margin="0,12,0,0" Padding="14,8" IsEnabled="False"
                            Click="Draw_Click"/>

                    <TextBlock x:Name="DrawNotice" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource Muted}" Margin="0,8,0,0" LineHeight="17"
                               Text="Drawing a route turns the trajectory on. It needs training mode (F7) in game, so laps you run with it are not countable."/>

                    <Border Margin="0,12,0,0" Padding="12,10"
                            Background="{StaticResource PanelAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Where this comes from" FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock x:Name="SourceNote" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                                       LineHeight="17"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
