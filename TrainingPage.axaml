<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Mhodume"
             x:Class="Mhodume.TrainingPage"
             x:CompileBindings="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
        <StackPanel MaxWidth="620" HorizontalAlignment="Left">

            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"
                       LineHeight="18"
                       Text="Press F7 in game to switch training mode on or off. It unlocks the features that could give an advantage — the trajectory overlay and the freecam — and marks the lap as not countable."/>

            <Border Margin="0,12,0,0" Padding="14,12"
                    Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="StateTitle" Text="Training mode is off"
                               FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="StateBody" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{StaticResource Muted}" FontSize="11" LineHeight="17"
                               Text="Start VHOLUME to see the current state here."/>
                </StackPanel>
            </Border>

            <local:SectionHeader Text="WHAT IT AFFECTS"/>
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Always available"
                           Foreground="{StaticResource Accent}" FontSize="12"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Crosshair, speed readout — cosmetic, laps still count"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Training only"
                           Foreground="{StaticResource Warn}" FontSize="12"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Trajectory overlay, freecam — laps stop counting"
                           FontSize="12" TextWrapping="Wrap"/>
            </Grid>

            <Border Margin="0,12,0,0" Padding="14,12"
                    Background="{StaticResource WarnFill}" BorderBrush="{StaticResource Warn}" BorderThickness="1">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarnText}" FontSize="11" LineHeight="17"
                           Text="Turning training mode back off does not rescue the lap. Once a run has been touched it stays uncountable until you restart the level — otherwise you could simply switch it off before the finish line."/>
            </Border>

            <local:SectionHeader Text="ON-SCREEN INDICATOR"/>
            <CheckBox Content="Show an indicator while training mode is on"
                      IsChecked="{Binding ShowBadge, Mode=TwoWay}" FontSize="13"/>

            <StackPanel IsEnabled="{Binding ShowBadge}">
                <Grid Margin="0,12,0,0" ColumnDefinitions="Auto,200">
                    <TextBlock Grid.Column="0" Text="Text" Classes="label"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                </Grid>

                <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,200">
                    <TextBlock Grid.Column="0" Text="Once tainted" Classes="label"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding TaintedText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                </Grid>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"
                           Text="Shown after you leave training mode, while the lap is still uncountable."/>

                <Grid Margin="0,12,0,8" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Opacity"
                               Classes="label" Margin="0,0,10,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="1" Classes="valueField">
                        <TextBlock Text="{Binding Opacity, StringFormat={}{0:0} %}"
                                   Classes="valueText"/>
                    </Border>
                </Grid>
                <Slider Minimum="10" Maximum="100"
                        Value="{Binding Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Grid Margin="0,12,0,8" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Size"
                               Classes="label" Margin="0,0,10,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="1" Classes="valueField">
                        <TextBlock Text="{Binding Scale, StringFormat={}{0:0.0}×}"
                                   Classes="valueText"/>
                    </Border>
                </Grid>
                <Slider Minimum="0.5" Maximum="4" TickFrequency="0.1" IsSnapToTickEnabled="True"
                        Value="{Binding Scale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Grid Margin="0,12,0,8" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Distance from the corner"
                               Classes="label" Margin="0,0,10,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="1" Classes="valueField">
                        <TextBlock Text="{Binding Margin, StringFormat={}{0:0} px}"
                                   Classes="valueText"/>
                    </Border>
                </Grid>
                <Slider Minimum="0" Maximum="200"
                        Value="{Binding Margin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <Border Height="16"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
